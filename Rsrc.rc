ABOUTDLGBOX DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PDW"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "",IDC_STATIC,8,8,72,64
    LTEXT           "PDW version",IDC_VERSION,90,12,326,12
    LTEXT           "Architecture",IDC_ABOUT_ARCHITECTURE,90,29,326,12
    LTEXT           "Native Windows decoder for POCSAG, FLEX, ERMES, ACARS and MOBITEX.",IDC_STATIC,90,46,326,22
    LTEXT           "Inputs include established audio and serial/slicer paths, RTL-TCP, direct RTL-SDR, and WAV/SigMF replay. Current tools include the Capcode Directory, live filtering, optional bounded Message History with CSV export, diagnostics, multi-receiver support, and bounded pager-message reassembly.",IDC_ABOUT_FEATURES,14,82,402,52
    LTEXT           "The optional SDR# + VB-Audio Cable profile is selected by the operator. PDW does not install or configure those external products. Network and data outputs remain disabled until configured.",IDC_STATIC,14,140,402,34
    LTEXT           "Use PDW only where monitoring is lawful and authorised. Protect decoded content.",IDC_STATIC,14,179,402,12
    LTEXT           "GNU GPL v3 or later. Credits: Jason Petty, Peter Hunt, Herman Withaar, open-source contributors, Kieran O'Rourke and spiralshapeturtl.",IDC_STATIC,14,196,402,22
    PUSHBUTTON      "GitHub project",IDC_WEBSITE,14,226,84,18
    PUSHBUTTON      "Historical PDW site",IDC_ABOUT_HISTORICAL,104,226,104,18
    DEFPUSHBUTTON   "Close",IDOK,352,226,64,18
END

