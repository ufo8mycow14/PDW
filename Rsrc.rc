/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

PDWMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Log file...\tAlt+L",             IDM_LOGFILE
        MENUITEM "&Record signal...\tAlt+Shift+R",  IDM_RECORD
        MENUITEM "&Play recording...\tAlt+Shift+P", IDM_PLAYBACK
        MENUITEM SEPARATOR
        MENUITEM "&Save copied data...",            IDM_COPY_SAVE
        MENUITEM "&Print copied data...\tCtrl+P",   IDM_COPY_PRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",                   IDM_EXIT
    END
    POPUP "&Monitor"
    BEGIN
        MENUITEM "&Signal source and radio...",    IDM_SETTINGS_SIGNAL_PAGE
        MENUITEM "&Pause or resume",               IDT_TOOLBAR_BTN9
        MENUITEM SEPARATOR
        POPUP "&Decoder mode"
        BEGIN
            MENUITEM "&POCSAG / FLEX",             IDM_POCSAGFLEX
            MENUITEM "&ACARS",                     IDM_ACARS
            MENUITEM "&MOBITEX",                   IDM_MOBITEX
            MENUITEM "&ERMES",                     IDM_ERMES
        END
        MENUITEM SEPARATOR
        MENUITEM "&Statistics...\tAlt+S",          IDM_MONSTAT
        MENUITEM "&Diagnostics...\tF12",           IDM_DEBUG
    END
    POPUP "&Filters"
    BEGIN
		MENUITEM "&Capcode Directory...\tCtrl+F",   IDM_FILTERS
        MENUITEM "&Reload Capcode Directory\tCtrl+R", IDM_RELOAD
        MENUITEM "Reset &all hit counters...",     IDM_RESET_HITCOUNTERS
    END
    POPUP "&Outputs"
    BEGIN
        MENUITEM "Delivery &health...",             IDM_OUTPUT_HEALTH
        MENUITEM SEPARATOR
        MENUITEM "Publish to &web...",              IDM_PUBLISHING
        MENUITEM "&File transfer...",                IDM_FTP
        MENUITEM "&Push and Windows notifications...", IDM_APPRISE
        MENUITEM "&Email...\tCtrl+M",               IDM_MAIL
        MENUITEM "&Data outputs...",                 IDM_DATA_OUTPUTS
		MENUITEM "Local gateway &outbox...",           IDM_GATEWAY_OUTBOX
		MENUITEM "Local live &dashboard...",         IDM_LIVE_DASHBOARD
		MENUITEM "Guarded multi-&channel receivers...", IDM_MULTI_CHANNEL
    END
    POPUP "&View"
    BEGIN
		MENUITEM "Message &history...",              IDM_MESSAGE_HISTORY
		MENUITEM SEPARATOR
        MENUITEM "&Switch focused pane",             IDM_PANE_SWITCH
        MENUITEM "View and &columns...",             IDM_SCREENOPTIONS
        MENUITEM "&Scrollback...",                   IDM_SCROLLBACK
        MENUITEM SEPARATOR
        POPUP "&Theme"
        BEGIN
            MENUITEM "Follow &Windows",              IDM_THEME_SYSTEM
            MENUITEM "&Light",                       IDM_THEME_LIGHT
            MENUITEM "&Dark",                        IDM_THEME_DARK
        END
        MENUITEM "&Text and colours...",             IDM_COLOR
        MENUITEM "&Font...\tAlt+F",                  IDM_FONT
        MENUITEM "System &tray...\tCtrl+T",          IDM_SYSTEMTRAY
        MENUITEM SEPARATOR
        POPUP "&Character set"
        BEGIN
            MENUITEM "&Default",                     IDM_ENGLISH
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&User guide\tF1",                 IDM_HELP
        MENUITEM "&Keyboard shortcuts",              IDM_KEYBOARD_SHORTCUTS
        MENUITEM SEPARATOR
        MENUITEM "&About PDW...",                    IDM_ABOUT
    END
END

