# Synthetic POCSAG sync, one address, seven alpha words, then idle.
# Each row is one 32-bit word in transmission order (most-significant bit first).
01111100110100100001010111011000 # sync 0x7CD215D8
01001011010110100001101000100101 # address 0x4B5A1A25
10000101001000111101000011001011 # message 1 0x8523D0CB
11000001011001011001101100111100 # message 2 0xC1659B3C
10101110010010101000101011110100 # message 3 0xAE4A8AF4
10011010001001010110001110100010 # message 4 0x9A2563A2
11001110000100000100011001000110 # message 5 0xCE104646
11010110100011100101010100111000 # message 6 0xD68E5538
10101011100000110000011100100000 # message 7 0xAB830720
01111010100010011100000110010111 # idle 0x7A89C197
